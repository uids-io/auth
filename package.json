{
  "name": "@uids-io/auth",
  "version": "0.1.0",
  "description": "Production-ready auth package with OAuth/OIDC, sessions, devices, and Express integration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js"
    }
  },
  "files": [
    "dist",
    "src/db/migrations"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-migrations.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "jose": "^6.0.11",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.18.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "supertest": "^7.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "license": "MIT",
  "keywords": [
    "auth",
    "oauth",
    "oidc",
    "jwt",
    "express",
    "postgresql"
  ]
}
